rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isGuest() { return request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    // In a party you must use the username you own, or a guest name like "Guest Otter 42".
    // Guest names have spaces, so they can never look like an account.
    function realName(n) {
      return n is string && ((isGuest() && n.matches('Guest [A-Za-z]{2,12} [0-9]{2}'))
        || (n.matches('[A-Za-z0-9_]{3,16}')
          && get(/databases/$(database)/documents/usernames/$(n.lower())).data.uid == request.auth.uid));
    }

    match /usernames/{name} {
      allow get: if true;
      allow create: if request.auth != null && !isGuest()
        && request.resource.data.uid == request.auth.uid
        && name.matches('[a-z0-9_]{3,16}')
        && request.resource.data.name.lower() == name
        && request.resource.data.hasEmail is bool
        && request.resource.data.keys().hasOnly(['uid', 'name', 'hasEmail']);
    }

    match /parties/{code} {
      function isOwner() { return request.auth.uid == resource.data.owner; }
      // Only the player whose turn it is can add one move, or take back the last one.
      // Each move records the server's time for the clocks, so nobody can fake it.
      // Timed games have no undo.
      function moveOk() {
        let before = resource.data.match;
        let after = request.resource.data.match;
        let k = before.moves.size();
        let mover = k % 2 == 0 ? before.red : before.blue;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['match'])
          && after.diff(before).affectedKeys().hasOnly(['moves', 'times', 'last'])
          && request.auth.uid == mover
          && ((after.moves.size() == k + 1 && after.moves[k] is int
              && before.moves.concat([after.moves[k]]) == after.moves
              && after.last == request.time
              && after.times == before.times.concat([before.last.toMillis()]))
            || (k > 0 && before.clock == 0 && after.moves.size() == k - 1
              && after.moves.concat([before.moves[k - 1]]) == before.moves));
      }
      // The owner can't change a game that's being played, only start a fresh one.
      function matchOk() {
        let b = resource.data.match;
        let a = request.resource.data.match;
        return a == b || a == null
          || ((b == null || a.id != b.id) && a.moves.size() == 0 && a.times.size() == 0 && a.last == request.time);
      }
      allow get: if signedIn();
      // Only accounts can make a party; guests can join one.
      allow create: if signedIn() && !isGuest() && code.matches('[A-Z2-9]{5}')
        && request.resource.data.owner == request.auth.uid;
      allow update: if signedIn()
        && ((isOwner() && request.resource.data.owner == resource.data.owner && matchOk()) || moveOk());
      allow delete: if signedIn() && isOwner();

      match /members/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && uid == request.auth.uid
          && exists(/databases/$(database)/documents/parties/$(code))
          && request.resource.data.keys().hasOnly(['name', 'seen'])
          && realName(request.resource.data.name);
        allow delete: if signedIn() && (uid == request.auth.uid
          || get(/databases/$(database)/documents/parties/$(code)).data.owner == request.auth.uid);
      }

      match /chat/{id} {
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/parties/$(code)/members/$(request.auth.uid));
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'ts'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name == get(/databases/$(database)/documents/parties/$(code)/members/$(request.auth.uid)).data.name
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300
          && request.resource.data.ts == request.time;
      }
    }

    // Anytime games: moves are saved here so players can take their turns whenever they like.
    match /games/{code} {
      function player() { return request.auth.uid == resource.data.red || request.auth.uid == resource.data.blue; }
      function only(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
      function playing() { return resource.data.blue != '' && resource.data.done == false && resource.data.resigned == 0; }
      // The player whose turn it is adds one move, or takes back the other player's last move.
      function moveOk() {
        let before = resource.data.moves;
        let after = request.resource.data.moves;
        let k = before.size();
        let mover = k % 2 == 0 ? resource.data.red : resource.data.blue;
        return only(['moves', 'done', 'updated']) && playing()
          && request.auth.uid == mover
          && request.resource.data.done is bool
          && request.resource.data.updated == request.time
          && ((after.size() == k + 1 && after[k] is int && before.concat([after[k]]) == after)
            || (k > 0 && request.resource.data.done == false && after.size() == k - 1
              && after.concat([before[k - 1]]) == before));
      }
      function joinOk() {
        return only(['blue', 'blueName', 'players', 'updated'])
          && resource.data.blue == ''
          && request.auth.uid == resource.data.invitee
          && request.resource.data.blue == request.auth.uid
          && request.resource.data.players == [resource.data.red, request.auth.uid]
          && realName(request.resource.data.blueName)
          && request.resource.data.updated == request.time;
      }
      function resignOk() {
        return only(['resigned', 'done', 'updated']) && playing() && player()
          && request.resource.data.resigned == (request.auth.uid == resource.data.red ? 1 : 2)
          && request.resource.data.done == true
          && request.resource.data.updated == request.time;
      }
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.players;
      // Games start from an invite in Messages, so only accounts can make one, and only the invited player can join.
      allow create: if signedIn() && !isGuest() && code.matches('[A-Z2-9]{5}')
        && request.resource.data.keys().hasOnly(['game', 'opts', 'red', 'blue', 'redName', 'blueName', 'invitee', 'inviteeName', 'players', 'moves', 'done', 'resigned', 'updated'])
        && request.resource.data.invitee is string && request.resource.data.invitee != request.auth.uid
        && request.resource.data.inviteeName is string
        && request.resource.data.game in ['normal', 'ultimate', 'supreme', 'mega']
        && request.resource.data.red == request.auth.uid
        && request.resource.data.blue == '' && request.resource.data.blueName == ''
        && request.resource.data.players == [request.auth.uid]
        && request.resource.data.moves == []
        && request.resource.data.done == false && request.resource.data.resigned == 0
        && realName(request.resource.data.redName)
        && request.resource.data.updated == request.time;
      allow update: if signedIn() && (moveOk() || joinOk() || resignOk());
      // A player can cancel a game nobody has joined, or remove a finished one.
      allow delete: if signedIn() && player() && (resource.data.blue == '' || resource.data.done == true);

      match /chat/{id} {
        function g() { return get(/databases/$(database)/documents/games/$(code)).data; }
        allow read: if signedIn() && (request.auth.uid == g().red || request.auth.uid == g().blue);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'ts'])
          && request.resource.data.uid == request.auth.uid
          && ((request.auth.uid == g().red && request.resource.data.name == g().redName)
            || (request.auth.uid == g().blue && request.resource.data.name == g().blueName))
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300
          && request.resource.data.ts == request.time;
      }
    }

    // Messages between two accounts. The conversation id is the two account ids in order, joined by _.
    match /dms/{id} {
      function member() { return request.auth.uid in resource.data.users; }
      function owns(d, u) { return d.names[u] is string
        && get(/databases/$(database)/documents/usernames/$(d.names[u].lower())).data.uid == u; }
      allow get: if signedIn() && (resource == null || member());
      allow list: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn() && !isGuest()
        && request.resource.data.keys().hasOnly(['users', 'names', 'last', 'read', 'updated'])
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users[0] < request.resource.data.users[1]
        && id == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.names.keys().hasOnly(request.resource.data.users)
        && owns(request.resource.data, request.resource.data.users[0])
        && owns(request.resource.data, request.resource.data.users[1])
        && request.resource.data.last == null
        && request.resource.data.read == {}
        && request.resource.data.updated == request.time;
      // Members can mark it read, and record their own latest message for the list.
      allow update: if signedIn() && member() && !isGuest()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last', 'read', 'updated'])
        && request.resource.data.read.diff(resource.data.read).affectedKeys().hasOnly([request.auth.uid])
        && (request.resource.data.last == resource.data.last
          || (request.resource.data.last.keys().hasOnly(['from', 'text', 'ts'])
            && request.resource.data.last.from == request.auth.uid
            && request.resource.data.last.text is string
            && request.resource.data.last.text.size() <= 120
            && request.resource.data.last.ts == request.time))
        && (request.resource.data.updated == resource.data.updated || request.resource.data.updated == request.time);

      match /msgs/{m} {
        function users() { return get(/databases/$(database)/documents/dms/$(id)).data.users; }
        allow read: if signedIn() && request.auth.uid in users();
        allow create: if signedIn() && !isGuest() && request.auth.uid in users()
          && request.resource.data.keys().hasOnly(['from', 'text', 'ts', 'invite'])
          && (!('invite' in request.resource.data)
            || (request.resource.data.invite.keys().hasOnly(['kind', 'code', 'game'])
              && request.resource.data.invite.kind in ['live', 'unsynced']
              && request.resource.data.invite.code.matches('[A-Z2-9]{5}')
              && request.resource.data.invite.game in ['normal', 'ultimate', 'supreme', 'mega']))
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.ts == request.time;
      }
    }
  }
}
